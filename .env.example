# Copy to .env and adjust. Every value is optional in development.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://inventory.example.rw
DJANGO_TIME_ZONE=Africa/Kigali

# --- PostgreSQL (leave POSTGRES_DB unset to use SQLite for development) ---
# POSTGRES_DB=smart_inventory
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Forecasting & alerts ---
SIS_FORECAST_HORIZON_DAYS=14
SIS_HOLDOUT_DAYS=28
SIS_MIN_HISTORY_DAYS=42
SIS_HISTORY_WINDOW_DAYS=365
SIS_EXPIRY_WARNING_DAYS=30
# z-value for computed safety stock (1.65 ≈ 95% cycle service level)
SIS_SERVICE_LEVEL_Z=1.65

# --- MQTT bridge (python manage.py mqtt_bridge) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=False
MQTT_TOPIC=sis/+/readings
